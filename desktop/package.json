{
  "name": "free-games-hub-desktop",
  "version": "0.3.1",
  "description": "Free Games Hub — desktop app (Electron + React)",
  "main": "out/main/index.js",
  "author": "Marcos",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/Marcospena12/free-games-alert",
  "desktopName": "free-games-hub",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "electron-vite preview",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@tanstack/react-query": "^5.51.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.452.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
